# Configuración de Entorno para Bybit EU Spot Grid Trading Bot
# Copia este archivo como .env y completa con tus claves reales:
# cp .env.example .env

# Credenciales de API de Bybit (Dominio EU Spot)
BYBIT_API_KEY=tu_api_key_aqui
BYBIT_API_SECRET=tu_api_secret_aqui

# Notificaciones opcionales de Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Otras integraciones opcionales
CMC_API_KEY=
